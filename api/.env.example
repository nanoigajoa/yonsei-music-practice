# Firebase 서비스 계정 JSON 전체를 한 줄로 입력
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# 최소 32자 임의 문자열: openssl rand -hex 32
BOOKING_TOKEN_SECRET=

# 시험 예약은 기본 비활성화. 현장 실험 때만 true
BOOKING_ENABLED=false

# 시험을 허용할 방 번호만 쉼표로 구분
ALLOWED_TEST_ROOMS=119

# 공실 배경 갱신 간격. 클릭 예약은 이 값과 무관하게 원본을 즉시 재조회한다.
POLL_INTERVAL_SECONDS=20

# 허용할 프론트 주소(쉼표 구분). 예: https://example.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# /push를 사용하는 기존 공실 업로더용
PUSH_SECRET=
