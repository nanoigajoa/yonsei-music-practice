# Cloudflare Zero Trust에서 만든 Tunnel 토큰
CLOUDFLARE_TUNNEL_TOKEN=

# Firebase 서비스 계정 JSON 전체(한 줄)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# `openssl rand -hex 32` 결과
BOOKING_TOKEN_SECRET=

# 현장 시험 직전에만 true로 바꾼다
BOOKING_ENABLED=false
ALLOWED_TEST_ROOMS=119

# 시험용 Vercel 주소
ALLOWED_ORIGINS=https://your-staging-project.vercel.app

# 기존 pusher를 이 API와 함께 사용할 때만 설정
PUSH_SECRET=
